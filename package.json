{
  "name": "rexermi-os",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema de gestión profesional Rexermi OS",
  "author": "Rexermi",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run backend:build",
    "backend:build": "esbuild backend/src/index.js --bundle --platform=node --target=node18 --outfile=backend/dist/index.cjs --external:prisma --external:@prisma/client",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:start": "wait-on http://localhost:5173 && npm run electron:dev",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.rexermi.os",
    "productName": "Rexermi OS",
    "directories": {
      "output": "release"
    },
    "files": [
      "!**/*",
      "dist/**/*",
      "electron/**/*",
      "backend/dist/**/*",
      "backend/prisma/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/@prisma/engines",
        "to": "node_modules/@prisma/engines",
        "filter": [
          "query_engine-windows.exe",
          "migration_engine-windows.exe"
        ]
      },
      {
        "from": "node_modules/@prisma/client",
        "to": "node_modules/@prisma/client",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/.prisma",
        "to": "node_modules/.prisma",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "publish": null
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "npmRebuild": false
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.363.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "electron": "41.0.3",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "esbuild": "^0.20.2",
    "postcss": "^8.4.49",
    "prisma": "^6.19.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "wait-on": "^9.0.4"
  }
}
